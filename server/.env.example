# 平台后端配置
HOST=127.0.0.1
PORT=8787

# 上游 muse2api（必须与 upstream/muse2api/.env 里的 MUSE2API_KEY 一致）
MUSE_BASE=http://127.0.0.1:18610
MUSE_KEY=m2a_muse_studio_local_2026

# 登录签名密钥，生产务必替换
JWT_SECRET=change-this-to-a-long-random-string
JWT_DAYS=14

# 对外访问地址（留空自动识别）
PUBLIC_BASE=

# 管理员
ADMIN_EMAIL=admin@muse.local
ADMIN_PASSWORD=admin123456

# 定价（积分）：视频 = base + 每秒单价 × 时长
PRICE_VIDEO_BASE=10
PRICE_VIDEO_PER_SEC=2
PRICE_IMAGE=5

# 注册赠送积分 / 是否开放注册
SIGNUP_CREDITS=100
ALLOW_REGISTER=1
